{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(python3 -c:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv pip install:*)",
      "Bash(pip install -e .)",
      "Bash(ls:*)",
      "Bash(cat pyproject.toml)",
      "Bash(katapult-helper --help)",
      "Bash(katapult-helper * --help)"
    ],
    "deny": [
      "Bash(sudo systemctl:*)",
      "Bash(make flash:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
